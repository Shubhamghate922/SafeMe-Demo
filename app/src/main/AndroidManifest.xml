<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Connectivity -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Location & Foreground Journey Monitoring Service -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Feature-Gated Hardware Permissions (Requested Only on Explicit User Action) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <queries>
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name="com.safeme.app.SafeMeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeMe">

        <!-- Google Maps SDK API Key injected from Secrets / .env -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Launcher Splash Activity -->
        <activity
            android:name="com.safeme.app.activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SafeMe.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.safeme.app.activities.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeMe" />

        <activity
            android:name="com.safeme.app.activities.PermissionsActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeMe" />

        <activity
            android:name="com.safeme.app.activities.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeMe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.safeme.app.activities.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeMe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.safeme.app.activities.OtpVerificationActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeMe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.safeme.app.activities.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeMe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.safeme.app.activities.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SafeMe"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.safeme.app.activities.FakeCallActivity"
            android:exported="false"
            android:theme="@style/Theme.SafeMe" />

        <!-- User-Initiated Active Journey & SOS Location Foreground Service -->
        <service
            android:name="com.safeme.app.services.JourneyLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name="com.safeme.app.notifications.SafeMeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
