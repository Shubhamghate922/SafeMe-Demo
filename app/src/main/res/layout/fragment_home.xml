<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safeme_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Backend Error / Retry Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/safeme_emergency_red_soft"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvHomeError"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/safeme_emergency_red"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHomeRetry"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/retry"
                        android:textColor="@color/safeme_emergency_red" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- User Welcome Header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/safeme_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/safeme_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivHomeAvatar"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_circle_lavender"
                            android:contentDescription="Profile picture"
                            android:padding="10dp"
                            android:src="@drawable/ic_profile"
                            app:tint="@color/safeme_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHomeWelcome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hello, User"
                                android:textColor="@color/safeme_text_main"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHomeDateTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/safeme_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Live Status Pills: GPS, Network, Contacts -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvHomeGpsStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_lavender"
                            android:gravity="center"
                            android:paddingVertical="6dp"
                            android:text="GPS: Checking"
                            android:textColor="@color/safeme_deep_purple"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHomeNetStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_lavender"
                            android:gravity="center"
                            android:paddingVertical="6dp"
                            android:text="Net: Checking"
                            android:textColor="@color/safeme_deep_purple"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHomeContactsCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_pill_lavender"
                            android:gravity="center"
                            android:paddingVertical="6dp"
                            android:text="Contacts: --"
                            android:textColor="@color/safeme_deep_purple"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Active Journey Status Card (Shown when journey is ACTIVE) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomeActiveJourney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/safeme_light_lavender"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/safeme_primary"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE JOURNEY IN PROGRESS"
                        android:textColor="@color/safeme_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHomeActiveDestination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/safeme_text_main"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHomeActiveEta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/safeme_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHomeOpenActiveJourney"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:text="Monitor Active Journey"
                        android:textAllCaps="false"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Large Visible Red Emergency SOS Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/safeme_surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/safeme_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <FrameLayout
                        android:layout_width="172dp"
                        android:layout_height="172dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_sos_pulse_ring" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHomeSosBig"
                            android:layout_width="142dp"
                            android:layout_height="142dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_sos_circle"
                            android:contentDescription="Trigger Emergency SOS"
                            android:text="SOS\nALERT"
                            android:textColor="@color/safeme_white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null"
                            app:cornerRadius="71dp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Tap to open Emergency SOS &amp; notify trusted contacts"
                        android:textColor="@color/safeme_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:text="Quick Safety Actions"
                android:textColor="@color/safeme_text_main"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Row 1: Start Journey & Emergency SOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickStartJourney"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Start Journey"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_journey" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickEmergencySos"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/safeme_emergency_red"
                    android:text="Emergency SOS"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_warning" />
            </LinearLayout>

            <!-- Row 2: Trusted Contacts & Safety Check-in -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickTrustedContacts"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Trusted Contacts"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_contacts" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickSafetyCheckIn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Safety Check-in"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_check" />
            </LinearLayout>

            <!-- Row 3: Community Safety Map & Emergency Helplines -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickCommunityMap"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Community Map"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_map" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickHelplines"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Helplines (112)"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_phone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
