<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safeme_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/safeme_surface"
            app:cardCornerRadius="20dp"
            app:strokeColor="@color/safeme_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/ivProfilePhoto"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_circle_lavender"
                    android:contentDescription="Profile photo"
                    android:padding="18dp"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/safeme_primary" />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/safeme_text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/safeme_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvProfileMobile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/safeme_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvProfileVerified"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill_lavender"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/safeme_deep_purple"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileEdit"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Edit Profile"
            android:textAllCaps="false"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileChangePassword"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Change Password"
            android:textAllCaps="false"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_lock" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileContacts"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Manage Trusted Contacts"
            android:textAllCaps="false"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_contacts" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfilePermissions"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Manage Safety Permissions"
            android:textAllCaps="false"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_safety" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="App Settings"
            android:textAllCaps="false"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_settings" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileAbout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="About SafeMe"
            android:textAllCaps="false"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_info" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Logout"
            android:textAllCaps="false"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_logout" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileDeleteAccount"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="Delete Account Permanently"
            android:textAllCaps="false"
            android:textColor="@color/safeme_emergency_red" />

    </LinearLayout>
</ScrollView>
