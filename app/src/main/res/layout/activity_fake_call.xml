<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12111A"
    android:padding="24dp">

    <!-- Setup Container -->
    <LinearLayout
        android:id="@+id/layoutFakeCallSetup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_outlined"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_lavender"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="APPLICATION SIMULATION ONLY"
            android:textColor="@color/safeme_deep_purple"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Simulated Fake Call"
            android:textColor="@color/safeme_text_main"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Creates a realistic simulated incoming call UI to help you exit uncomfortable situations safely. This is an app simulation, not a real telephone call."
            android:textColor="@color/safeme_text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Caller Name (e.g. Mom, Dad, Cab Driver)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFakeCallerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mom" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Trigger Delay"
            android:textColor="@color/safeme_text_main"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFakeDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDelayNow"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Now" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDelay5s"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 sec" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDelay15s"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 sec" />
        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseFakeCallSetup"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartFakeCall"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Start Fake Call"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Simulated Ringing / Active Call UI -->
    <LinearLayout
        android:id="@+id/layoutFakeCallRinging"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#33FFFFFF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="SIMULATED CALL UI"
            android:textColor="@color/safeme_white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSimCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Incoming Call…"
            android:textColor="#D0CDE6"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSimCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Mom"
            android:textColor="@color/safeme_white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSimCallTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="00:00"
            android:textColor="@color/safeme_success_green"
            android:textSize="18sp"
            android:visibility="gone" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabRejectFakeCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:contentDescription="Reject simulated call"
                android:src="@drawable/ic_call_end"
                app:backgroundTint="@color/safeme_emergency_red"
                app:tint="@color/safeme_white" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAcceptFakeCall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Accept simulated call"
                android:src="@drawable/ic_phone"
                app:backgroundTint="@color/safeme_success_green"
                app:tint="@color/safeme_white" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
