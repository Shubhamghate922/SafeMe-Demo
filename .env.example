# GEMINI_API_KEY: Required for Gemini AI API calls if used.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# API_BASE_URL: Spring Boot backend REST API base URL.
# Use http://10.0.2.2:8080/api/v1/ for Android Emulator connecting to localhost backend.
# For physical devices, configure your LAN IP or HTTPS domain here or in App Settings -> Server Configuration.
API_BASE_URL=http://10.0.2.2:8080/api/v1/

# MAPS_API_KEY: Google Maps SDK for Android API Key.
# Configure via the AI Studio Secrets panel or local .env file.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
